{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MStudo Desktop",
  "version": "0.1.1",
  "identifier": "com.mstudo.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MStudo Desktop",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Vietnamese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
