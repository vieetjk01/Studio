# ─────────────────────────────────────────────────────────────
# Vieetjk Photo Collection — Environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it contains secrets.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server only, used for admin operations (managing photographers).
# Keep this SECRET. Do not expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Drive API key — server only (used to list folder contents).
# Restrict it to the Drive API in Google Cloud Console.
GOOGLE_API_KEY=your-google-api-key
