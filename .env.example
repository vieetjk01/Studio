# ─────────────────────────────────────────────────────────────
# Vieetjk Photo Collection — Environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it contains secrets.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server only, used for admin operations (managing photographers).
# Keep this SECRET. Do not expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Drive API key — server only (used to list folder contents).
# Restrict it to the Drive API in Google Cloud Console.
GOOGLE_API_KEY=your-google-api-key

# ── Google Picker (compress tool: pick + write back to a user's own Drive) ──
# Lets ANY signed-in Google user compress images on their OWN Drive using the
# non-sensitive `drive.file` scope (no Google verification / no warning screen).
# Create an OAuth Web client + an API key in the same Google Cloud project, and
# enable the "Google Picker API". Leave unset to hide the picker (link mode only).
#   CLIENT_ID -> OAuth 2.0 Web client ID (add your site origins to "Authorized JS origins")
#   API_KEY   -> browser API key (restrict to your domains + the Picker API)
#   APP_ID    -> the Google Cloud project NUMBER (for drive.file Picker access)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-oauth-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_API_KEY=your-browser-api-key
NEXT_PUBLIC_GOOGLE_APP_ID=your-gcp-project-number

# ── Domain split (optional) ──────────────────────────────────────────────
# Set these to serve the public site, the app, and the image tools on separate
# hosts:
#   MAIN_HOST   -> public profile, showcase albums, booking, contact, social
#   APP_HOST    -> login, dashboard, album management, studio, customer selection (/a)
#   IMG_HOST    -> image-compress tool ("Nén ảnh"); requires login
#   ADMIN_HOST  -> site administration + settings (admins only)
# Leave unset for local dev / *.vercel.app (the full app runs on one host).
NEXT_PUBLIC_MAIN_HOST=mstudo.com
NEXT_PUBLIC_APP_HOST=album.mstudo.com
NEXT_PUBLIC_IMG_HOST=img.mstudo.com
NEXT_PUBLIC_ADMIN_HOST=admin.mstudo.com
